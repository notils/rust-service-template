# Copy to .env and fill in. Never commit .env.

# --- Postgres (docker compose reads these) ---
POSTGRES_USER={{project-name}}
POSTGRES_PASSWORD=change-me-locally
POSTGRES_DB={{project-name}}_dev

# --- Required ---
DATABASE_URL=postgres://{{project-name}}:change-me-locally@127.0.0.1:5433/{{project-name}}_dev

# --- Server (optional; defaults shown) ---
# 0.0.0.0 accepts both LAN and loopback. Use 127.0.0.1 to bind loopback only.
HOST=0.0.0.0
PORT=8080
REQUEST_TIMEOUT_SECONDS=30

# --- Connection pool (optional) ---
DATABASE_MAX_CONNECTIONS=10
# Logs every SQL statement. Local debugging only: statements can carry personal data.
DATABASE_LOG_STATEMENTS=false

# --- Logging (optional) ---
RUST_LOG=info,{{crate_name}}_api=debug,{{crate_name}}_db=debug
# Set to `json` in deployment for machine-parseable logs.
LOG_FORMAT=
